generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  DRIVER
  OWNER
  ADMIN
}

enum ParkingStatus {
  AVAILABLE
  UNAVAILABLE
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  ACTIVE
  EXTENSION_REQUESTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  CASH
  WALLET
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id            BigInt        @id @default(autoincrement())
  name          String        @db.VarChar(255)
  email         String        @unique @db.VarChar(255)
  password      String        @db.VarChar(255)
  phone         String?       @db.VarChar(255)
  role          Role
  profileImage  String?       @map("profile_image") @db.VarChar(255)
  walletBalance Decimal       @default(0.00) @map("wallet_balance") @db.Decimal(10, 2)
  enabled       Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  parkingSpots  ParkingSpot[]
  bookings      Booking[]

  @@map("users")
}

model ParkingSpot {
  id                   BigInt        @id @default(autoincrement())
  ownerId              BigInt        @map("owner_id")
  title                String        @db.VarChar(255)
  description          String?       @db.Text
  address              String        @db.VarChar(255)
  city                 String        @db.VarChar(255)
  latitude             Float         @db.Double
  longitude            Float         @db.Double
  pricePerHour         Decimal       @map("price_per_hour") @db.Decimal(10, 2)
  peakPricePerHour     Decimal?      @map("peak_price_per_hour") @db.Decimal(10, 2)
  capacity             Int?          @default(1)
  covered              Boolean       @default(false)
  securityAvailable    Boolean       @default(false) @map("security_available")
  evChargingAvailable  Boolean       @default(false) @map("ev_charging_available")
  imageUrl             String?       @map("image_url") @db.LongText
  operatingHours       String?       @map("operating_hours") @db.VarChar(255)
  status               ParkingStatus @default(AVAILABLE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  owner                User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings             Booking[]

  @@map("parking_spots")
}

model Booking {
  id               BigInt        @id @default(autoincrement())
  userId           BigInt        @map("user_id")
  parkingSpotId    BigInt        @map("parking_spot_id")
  startTime        DateTime      @map("start_time")
  endTime          DateTime      @map("end_time")
  amount           Decimal       @db.Decimal(10, 2)
  status           BookingStatus @default(PENDING)
  bookingReference String        @unique @map("booking_reference") @db.VarChar(255)
  qrCode           String?       @unique @map("qr_code") @db.VarChar(255)
  vehicleNumber    String?       @map("vehicle_number") @db.VarChar(255)
  vehicleType      String?       @map("vehicle_type") @db.VarChar(255)
  extensionHours   Int?          @map("extension_hours")
  cancellationFee  Decimal?      @map("cancellation_fee") @db.Decimal(10, 2)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingSpot      ParkingSpot   @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)
  payments         Payment[]
  reviews          Review[]

  @@map("bookings")
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  bookingId     BigInt        @map("booking_id")
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String        @unique @map("transaction_id") @db.VarChar(255)
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id        BigInt   @id @default(autoincrement())
  bookingId BigInt   @map("booking_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
