{
  "name": "smartpark-backend",
  "version": "1.0.0",
  "description": "SmartPark Backend API with Express, Prisma, Socket.IO, Redis, and Razorpay",
  "main": "src/server.js",
  "scripts": {
    "start": "npx prisma db push --skip-generate --accept-data-loss && node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node src/config/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "axios": "^1.7.7",
    "kafkajs": "^2.2.4",
    "razorpay": "^2.9.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
